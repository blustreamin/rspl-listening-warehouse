# ============================================================================
# RSPL Listening Warehouse — environment
# ----------------------------------------------------------------------------
# SERVER-SIDE (Vercel project env vars). These are read only by the /api
# functions and NEVER shipped to the browser. Set at least one LLM provider; if
# none are set the app runs in deterministic seed mode (still fully renders).
# ============================================================================

# --- LLM providers (set one or more) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional: pin exact models (otherwise sensible defaults are used) ---
# GEMINI_MODEL=gemini-2.5-pro
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o

# --- Supabase persistence (service role — server only, bypasses RLS) ---
# Without these, persistence is simply skipped and the app still works.
SUPABASE_URL=https://skzkkwvafociwfggwzce.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: restrict CORS to your domain (defaults to *) ---
# CORS_ORIGIN=https://your-app.vercel.app

# ============================================================================
# CLIENT-SIDE (only this one is exposed to the browser, via Vite).
# Leave blank in production (same-origin). Set to your deployed URL only if you
# run `vite dev` locally against a deployed backend.
# ============================================================================
# VITE_API_BASE=
